# Dockerfile — SepsisWatch Web (static site via nginx)
FROM nginx:alpine

COPY webapp/ /usr/share/nginx/html/

# إعادة توجيه بسيطة تدعم روابط SPA-like من غير امتداد .html (اختياري)
RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / {\n\
        try_files $uri $uri.html $uri/ =404;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
